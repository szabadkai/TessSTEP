{
  "format_version": 1,
  "description": "Status of every instantiable AP242 geometric, topological and shape-representation entity for STEP import. `adapted` and `supertype` entries must be declared by an import profile in corpus/geometry; rules classify families by name pattern; explicit entries override rules. Verified and rendered by scripts/check_coverage.py.",
  "rules": [
    {
      "pattern": ".*KINEMATIC.*|.*_PAIR(_VALUE|_WITH_RANGE)?|ACTUATED_.*|.*_JOINT|.*_LINK|.*_LOOP_.*|PAIR_.*|ROTATION_ABOUT_DIRECTION|SU_PARAMETERS|RIGID_.*|.*_PATH_.*|MECHANISM.*|INTERPOLATED_CONFIGURATION_.*|LINEAR_.*(PAIR|FLEXIBLE).*|POINT_ON_PLANAR_CURVE_.*|POINT_ON_SURFACE_.*|.*_PAIR_.*",
      "status": "out_of_scope",
      "reason": "kinematics: no mechanism import is planned for v1.0"
    },
    {
      "pattern": "ANNOTATION_.*|.*_CALLOUT.*|CAMERA_.*|DRAUGHTING_.*|.*TEXT.*|.*_SYMBOL.*|.*HATCH.*|.*TILE.*|.*LEADER_LINE.*|.*_GLYPH.*|LIGHT_SOURCE.*|.*PLACEHOLDER.*|APLL_.*|PRESENTATION_.*|.*_IMAGE_.*|EXTERNAL_IMAGE.*|.*DIMENSION.*|.*DATUM.*|.*TOLERANCE.*|.*ANNOTATION.*|FILL_AREA_.*|.*_FILL_AREA.*|TERMINATOR_SYMBOL|PRE_DEFINED_.*|VIEW_VOLUME|PLANAR_EXTENT|PLANAR_BOX|.*_MARKER.*|POINT_STYLE|.*SURFACE_STYLE.*|GEOMETRIC_TOLERANCE.*|LEADER_.*|PROJECTION_.*|.*_ITEM_.*ASSOCIATIVITY",
      "status": "out_of_scope",
      "reason": "presentation, drawing and PMI: out of scope for v1.0 (colour and transparency are adapted from styled items, not from these items)"
    },
    {
      "pattern": ".*_2D|.*_2D_.*|CARTESIAN_11|CURVE_11|CYLINDRICAL_11|POLAR_11|SPHERICAL_11|AXIS2_PLACEMENT_2D|CARTESIAN_TRANSFORMATION_OPERATOR_2D|.*AREA.*|.*_WIREFRAME.*|POLYLINE_2D.*|CIRCULAR_INVOLUTE|CLOTHOID|SPIRAL",
      "status": "out_of_scope",
      "reason": "2D drafting geometry, wireframe models and plane curves without a surface use: not solid geometry"
    },
    {
      "pattern": ".*_VOLUME.*|CSG_.*|BOOLEAN_RESULT.*|BLOCK|RIGHT_ANGULAR_WEDGE|RIGHT_CIRCULAR_CONE|RIGHT_CIRCULAR_CYLINDER|SPHERE|TORUS|ELLIPSOID|CONVEX_HEXAHEDRON|CYCLIDE_SEGMENT_SOLID|ECCENTRIC_CONE|HALF_SPACE_SOLID|BOXED_HALF_SPACE|.*_SWEPT_(AREA|FACE)_SOLID|EXTRUDED_.*_SOLID|REVOLVED_.*_SOLID|SWEPT_(AREA|FACE)_SOLID|SOLID_REPLICA|.*SHELLED_SOLID|.*_SHELLED_SOLID|TRIMMED_VOLUME|VOLUME_WITH_.*|SOLID_WITH_.*|.*_FEATURE.*|MODIFIED_SOLID.*|.*_HOLE.*|.*_TRANSITION|.*_PATTERN.*|SOLID_CURVE_FONT|TETRAHEDRON|.*_PRIMITIVE.*|SHELLED_SOLID|.*_SOLID_2D",
      "status": "out_of_scope",
      "reason": "CSG primitives, solid volumes, swept solids and feature-based solids: only B-rep and tessellated solids are imported"
    },
    {
      "pattern": ".*_CONSTRAINT.*|.*GC_WITH_DIMENSION|.*ASSEMBLY_CONSTRAINT.*|.*_GEOMETRIC_CONSTRAINT.*|.*DIRECTION_REFERENCE|.*_SMOOTHNESS_.*|GEOMETRIC_ALIGNMENT|.*_DISTANCE.*|.*ANGLE_.*|EQUAL_PARAMETER_CONSTRAINT|FIXED_.*|FREE_FORM_.*|IMPLICIT_MODEL_INTERSECTION_CONSTRAINT|.*_ITEM_WITH_DIMENSION|SKETCH_.*|.*SKETCH.*|EXPLICIT_.*|INCIDENCE_.*|PGC_WITH_DIMENSION|.*PARALLEL.*|.*PERPENDICULAR.*|.*TANGENT.*|.*SYMMETRIC.*|.*COAXIAL.*|CURVE_LENGTH_.*|SURFACE_DISTANCE_.*|.*_REFERENCE_.*",
      "status": "out_of_scope",
      "reason": "explicit geometric and assembly constraints: design-intent data with no mesh"
    },
    {
      "pattern": "POINT_CLOUD.*|SCAN_.*|.*_SCAN.*|POINT_REPLICA|CURVE_REPLICA|SURFACE_REPLICA|.*_REPLICA|.*_REPLICATE.*|MULTIPLE_ARITY_.*|UNARY_.*|BINARY_.*|VALUE_.*|.*_FUNCTION.*|GENERIC_.*|.*_SEGMENT_SET|CURVE_SEGMENT_SET|.*_ITEM_SET|PROCEDURAL_.*|.*_TESSELLATED_(CONNECTING_EDGE|EDGE|TRIANGULATED_FACE)|CUBIC_.*|.*_BEZIER_TESSELLATED_.*|TESSELLATED_(CURVE_SET|POINT_SET|WIRE|CONNECTING_EDGE|VERTEX|EDGE|GEOMETRIC_SET|STRUCTURED_ITEM|ANNOTATION_OCCURRENCE|SOLID_SET|SURFACE_SET|VERTEX_POINT|EDGE_CURVE|FACE_SURFACE|OPEN_SHELL|CLOSED_SHELL)|.*TESSELLATED_(CURVE|POINT|WIRE|CONNECTING|EDGE|VERTEX|GEOMETRIC|STRUCTURED|SOLID|SURFACE|ANNOTATION).*|ADJACENT_.*|.*_ITEM_LIST|ITEM_DEFINED_TRANSFORMATION|MAPPED_ITEM|REPRESENTATION_ITEM|GEOMETRIC_REPRESENTATION_ITEM|TOPOLOGICAL_REPRESENTATION_ITEM|VERTEX|SUBEDGE|SUBFACE|SUBPATH|PATH|OPEN_PATH|ORIENTED_PATH|.*_SUB_SET|CONNECTED_EDGE_SET|CONNECTED_FACE_SET|EDGE_BOUNDED_CURVE_WITH_LENGTH|BOUNDED_CURVE_WITH_LENGTH|.*_SHELL_BASED.*|VERTEX_SHELL|WIRE_SHELL|ORIENTED_FACE|ORIENTED_OPEN_SHELL|SURFACED_OPEN_SHELL|OPEN_SHELL|EDGE_BASED_WIREFRAME_MODEL|.*_PLACEMENT_SHAPE_REPRESENTATION|LOCATION_SHAPE_REPRESENTATION|DIRECTION_SHAPE_REPRESENTATION|SHAPE_REPRESENTATION_WITH_PARAMETERS|SHAPE_DIMENSION_REPRESENTATION|REPRESENTATIVE_SHAPE_REPRESENTATION|.*_SHEET_REPRESENTATION|COMPOUND_SHAPE_REPRESENTATION|NEUTRAL_SKETCH_REPRESENTATION|HYBRID_BREP_SHAPE_REPRESENTATION|CURVE_SWEPT_SOLID_SHAPE_REPRESENTATION|.*CSG.*",
      "status": "unsupported",
      "reason": "outside every import profile; a root or item of this type is rejected naming the entity"
    }
  ],
