ISO-10303-21;
HEADER;
FILE_DESCRIPTION(('Original open tessellated shell with face and shell links to B-rep geometry; caller selects millimetres'),'2;1');
FILE_NAME('tessellated-shell.step','2026-09-26',('TessSTEP'),('TessSTEP'),'authored fixture','','');
FILE_SCHEMA(('AP242_MANAGED_MODEL_BASED_3D_ENGINEERING_MIM_LF'));
ENDSEC;
DATA;
#1=COORDINATES_LIST('',6,((0.,0.,0.),(10.,0.,0.),(10.,20.,0.),(0.,20.,0.),(0.,0.,30.),(10.,0.,30.)));
#10=CARTESIAN_POINT('',(0.,0.,0.));
#11=CARTESIAN_POINT('',(10.,0.,0.));
#12=CARTESIAN_POINT('',(10.,0.,30.));
#13=CARTESIAN_POINT('',(0.,0.,30.));
#14=DIRECTION('',(0.,-1.,0.));
#15=DIRECTION('',(1.,0.,0.));
#16=AXIS2_PLACEMENT_3D('',#10,#14,#15);
#17=PLANE('',#16);
#18=POLY_LOOP('',(#10,#11,#12,#13));
#19=FACE_OUTER_BOUND('',#18,.T.);
#20=ADVANCED_FACE('',(#19),#17,.T.);
#21=OPEN_SHELL('',(#20));
#100=TRIANGULATED_FACE('bottom',#1,6,(),$,(),((1,4,3),(1,3,2)));
#101=COMPLEX_TRIANGULATED_FACE('front',#1,4,((0.,-1.,0.)),#20,(1,2,5,6),((1,2,3,4)),());
#1000=TESSELLATED_SHELL('corner',(#100,#101),#21);
ENDSEC;
END-ISO-10303-21;
