(* Original bounded import profile, not an ISO schema. Matches the physical
   attributes of triangulated tessellated solids, shells, faces and surface sets;
   excludes general AP rules. Link attributes are generalized to
   representation_item: the importer retains their targets without decoding them. *)
SCHEMA tessstep_tessellated;
ENTITY representation_item;
 name : STRING;
END_ENTITY;
ENTITY coordinates_list SUBTYPE OF (representation_item);
 npoints : INTEGER;
 position_coords : LIST [1:?] OF LIST [3:3] OF REAL;
END_ENTITY;
ENTITY tessellated_face ABSTRACT SUBTYPE OF (representation_item);
 coordinates : coordinates_list;
 pnmax : INTEGER;
 normals : LIST [0:?] OF LIST [3:3] OF REAL;
 geometric_link : OPTIONAL representation_item;
END_ENTITY;
ENTITY triangulated_face SUBTYPE OF (tessellated_face);
 pnindex : LIST [0:?] OF INTEGER;
 triangles : LIST [1:?] OF LIST [3:3] OF INTEGER;
END_ENTITY;
ENTITY complex_triangulated_face SUBTYPE OF (tessellated_face);
 pnindex : LIST [0:?] OF INTEGER;
 triangle_strips : LIST [0:?] OF LIST [3:?] OF INTEGER;
 triangle_fans : LIST [0:?] OF LIST [3:?] OF INTEGER;
END_ENTITY;
ENTITY tessellated_solid SUBTYPE OF (representation_item);
 items : SET [1:?] OF tessellated_face;
 geometric_link : OPTIONAL representation_item;
END_ENTITY;
ENTITY tessellated_shell SUBTYPE OF (representation_item);
 items : SET [1:?] OF tessellated_face;
 topological_link : OPTIONAL representation_item;
END_ENTITY;
ENTITY tessellated_surface_set ABSTRACT SUBTYPE OF (representation_item);
 coordinates : coordinates_list;
 pnmax : INTEGER;
 normals : LIST [0:?] OF LIST [3:3] OF REAL;
END_ENTITY;
ENTITY triangulated_surface_set SUBTYPE OF (tessellated_surface_set);
 pnindex : LIST [0:?] OF INTEGER;
 triangles : LIST [1:?] OF LIST [3:3] OF INTEGER;
END_ENTITY;
ENTITY complex_triangulated_surface_set SUBTYPE OF (tessellated_surface_set);
 pnindex : LIST [0:?] OF INTEGER;
 triangle_strips : LIST [0:?] OF LIST [3:?] OF INTEGER;
 triangle_fans : LIST [0:?] OF LIST [3:?] OF INTEGER;
END_ENTITY;
END_SCHEMA;
