(* Original bounded import profile, not an ISO schema. Matches the physical
   attributes used by planar FACETED_BREP geometry; excludes general AP rules. *)
SCHEMA tessstep_faceted;
ENTITY representation_item;
 name : STRING;
END_ENTITY;
ENTITY cartesian_point SUBTYPE OF (representation_item);
 coordinates : LIST [3:3] OF REAL;
END_ENTITY;
ENTITY direction SUBTYPE OF (representation_item);
 direction_ratios : LIST [3:3] OF REAL;
END_ENTITY;
ENTITY axis2_placement_3d SUBTYPE OF (representation_item);
 location : cartesian_point;
 axis : OPTIONAL direction;
 ref_direction : OPTIONAL direction;
END_ENTITY;
ENTITY plane SUBTYPE OF (representation_item);
 position : axis2_placement_3d;
END_ENTITY;
ENTITY poly_loop SUBTYPE OF (representation_item);
 polygon : LIST [3:?] OF UNIQUE cartesian_point;
END_ENTITY;
ENTITY face_bound SUBTYPE OF (representation_item);
 bound : poly_loop;
 orientation : BOOLEAN;
END_ENTITY;
ENTITY face_outer_bound SUBTYPE OF (face_bound);
END_ENTITY;
ENTITY face SUBTYPE OF (representation_item);
 bounds : SET [1:?] OF face_bound;
END_ENTITY;
ENTITY face_surface SUBTYPE OF (face);
 face_geometry : plane;
 same_sense : BOOLEAN;
END_ENTITY;
ENTITY advanced_face SUBTYPE OF (face_surface);
END_ENTITY;
ENTITY closed_shell SUBTYPE OF (representation_item);
 cfs_faces : SET [1:?] OF face_surface;
END_ENTITY;
ENTITY manifold_solid_brep SUBTYPE OF (representation_item);
 outer : closed_shell;
END_ENTITY;
ENTITY faceted_brep SUBTYPE OF (manifold_solid_brep);
END_ENTITY;
END_SCHEMA;
