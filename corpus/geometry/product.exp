(* Original bounded product-structure profile, not an ISO schema. Matches the
   physical attributes that AP203, AP214 and AP242 exporters write for products,
   product definitions, next assembly usage occurrences, shape definition
   representations, context dependent shape representations, item defined
   transformations and representation maps, together with their application
   contexts, geometric contexts, units and axis placements. Selects are reduced to
   the members these records use, associated documents are opaque links and shape
   representation subtypes add no attributes. Representation items are
   generalized to representation_item: the assembly linker retains those links
   without decoding them. General AP rules are excluded. *)
SCHEMA tessstep_product;
TYPE si_prefix = ENUMERATION OF
 (exa, peta, tera, giga, mega, kilo, hecto, deca, deci, centi, milli, micro, nano,
  pico, femto, atto);
END_TYPE;
TYPE si_unit_name = ENUMERATION OF
 (metre, gram, second, ampere, kelvin, mole, candela, radian, steradian, hertz,
  newton, pascal, joule, watt, coulomb, volt, farad, ohm, siemens, weber, tesla,
  henry, degree_celsius, lumen, lux, becquerel, gray, sievert);
END_TYPE;
TYPE source = ENUMERATION OF (made, bought, not_known);
END_TYPE;
TYPE length_measure = REAL;
END_TYPE;
TYPE positive_length_measure = REAL;
END_TYPE;
TYPE plane_angle_measure = REAL;
END_TYPE;
TYPE positive_plane_angle_measure = REAL;
END_TYPE;
TYPE ratio_measure = REAL;
END_TYPE;
TYPE positive_ratio_measure = REAL;
END_TYPE;
TYPE solid_angle_measure = REAL;
END_TYPE;
TYPE measure_value = SELECT
 (length_measure, positive_length_measure, plane_angle_measure,
  positive_plane_angle_measure, ratio_measure, positive_ratio_measure,
  solid_angle_measure);
END_TYPE;
TYPE characterized_definition = SELECT
 (product_definition, product_definition_relationship);
END_TYPE;
TYPE transformation = SELECT (item_defined_transformation);
END_TYPE;
ENTITY application_context;
 application : STRING;
END_ENTITY;
ENTITY application_context_element;
 name : STRING;
 frame_of_reference : application_context;
END_ENTITY;
ENTITY product_context SUBTYPE OF (application_context_element);
 discipline_type : STRING;
END_ENTITY;
ENTITY mechanical_context SUBTYPE OF (product_context);
END_ENTITY;
ENTITY product_definition_context SUBTYPE OF (application_context_element);
 life_cycle_stage : STRING;
END_ENTITY;
ENTITY design_context SUBTYPE OF (product_definition_context);
END_ENTITY;
ENTITY product;
 id : STRING;
 name : STRING;
 description : OPTIONAL STRING;
 frame_of_reference : SET [1:?] OF product_context;
END_ENTITY;
ENTITY product_definition_formation;
 id : STRING;
 description : OPTIONAL STRING;
 of_product : product;
END_ENTITY;
ENTITY product_definition_formation_with_specified_source
 SUBTYPE OF (product_definition_formation);
 make_or_buy : source;
END_ENTITY;
ENTITY product_definition;
 id : STRING;
 description : OPTIONAL STRING;
 formation : product_definition_formation;
 frame_of_reference : product_definition_context;
END_ENTITY;
(* Associated documents are retained as links; the linker never reads them. *)
ENTITY document;
 id : STRING;
END_ENTITY;
ENTITY product_definition_with_associated_documents SUBTYPE OF (product_definition);
 documentation_ids : SET [1:?] OF document;
END_ENTITY;
ENTITY product_definition_relationship;
 id : STRING;
 name : STRING;
 description : OPTIONAL STRING;
 relating_product_definition : product_definition;
 related_product_definition : product_definition;
END_ENTITY;
ENTITY product_definition_usage SUBTYPE OF (product_definition_relationship);
END_ENTITY;
ENTITY assembly_component_usage SUBTYPE OF (product_definition_usage);
 reference_designator : OPTIONAL STRING;
END_ENTITY;
ENTITY next_assembly_usage_occurrence SUBTYPE OF (assembly_component_usage);
END_ENTITY;
ENTITY property_definition;
 name : STRING;
 description : OPTIONAL STRING;
 definition : characterized_definition;
END_ENTITY;
ENTITY product_definition_shape SUBTYPE OF (property_definition);
END_ENTITY;
ENTITY property_definition_representation;
 definition : property_definition;
 used_representation : representation;
END_ENTITY;
ENTITY shape_definition_representation SUBTYPE OF (property_definition_representation);
END_ENTITY;
ENTITY dimensional_exponents;
 length_exponent : REAL;
 mass_exponent : REAL;
 time_exponent : REAL;
 electric_current_exponent : REAL;
 thermodynamic_temperature_exponent : REAL;
 amount_of_substance_exponent : REAL;
 luminous_intensity_exponent : REAL;
END_ENTITY;
(* The profile declares DIMENSIONS as a physical * slot for SI_UNIT, where the
   standard derives it from the unit name. *)
ENTITY named_unit;
 dimensions : dimensional_exponents;
END_ENTITY;
ENTITY length_unit SUBTYPE OF (named_unit);
END_ENTITY;
ENTITY plane_angle_unit SUBTYPE OF (named_unit);
END_ENTITY;
ENTITY solid_angle_unit SUBTYPE OF (named_unit);
END_ENTITY;
ENTITY si_unit SUBTYPE OF (named_unit);
 prefix : OPTIONAL si_prefix;
 name : si_unit_name;
END_ENTITY;
ENTITY conversion_based_unit SUBTYPE OF (named_unit);
 name : STRING;
 conversion_factor : measure_with_unit;
END_ENTITY;
ENTITY measure_with_unit;
 value_component : measure_value;
 unit_component : named_unit;
END_ENTITY;
ENTITY length_measure_with_unit SUBTYPE OF (measure_with_unit);
END_ENTITY;
ENTITY plane_angle_measure_with_unit SUBTYPE OF (measure_with_unit);
END_ENTITY;
ENTITY uncertainty_measure_with_unit SUBTYPE OF (measure_with_unit);
 name : STRING;
 description : OPTIONAL STRING;
END_ENTITY;
ENTITY representation_context;
 context_identifier : STRING;
 context_type : STRING;
END_ENTITY;
ENTITY geometric_representation_context SUBTYPE OF (representation_context);
 coordinate_space_dimension : INTEGER;
END_ENTITY;
ENTITY global_unit_assigned_context SUBTYPE OF (representation_context);
 units : SET [1:?] OF named_unit;
END_ENTITY;
ENTITY global_uncertainty_assigned_context SUBTYPE OF (representation_context);
 uncertainty : SET [1:?] OF uncertainty_measure_with_unit;
END_ENTITY;
ENTITY representation_item;
 name : STRING;
END_ENTITY;
ENTITY geometric_representation_item SUBTYPE OF (representation_item);
END_ENTITY;
ENTITY cartesian_point SUBTYPE OF (geometric_representation_item);
 coordinates : LIST [1:3] OF length_measure;
END_ENTITY;
ENTITY direction SUBTYPE OF (geometric_representation_item);
 direction_ratios : LIST [2:3] OF REAL;
END_ENTITY;
ENTITY axis2_placement_3d SUBTYPE OF (geometric_representation_item);
 location : cartesian_point;
 axis : OPTIONAL direction;
 ref_direction : OPTIONAL direction;
END_ENTITY;
ENTITY representation_map;
 mapping_origin : representation_item;
 mapped_representation : representation;
END_ENTITY;
ENTITY mapped_item SUBTYPE OF (representation_item);
 mapping_source : representation_map;
 mapping_target : representation_item;
END_ENTITY;
ENTITY representation;
 name : STRING;
 items : SET [1:?] OF representation_item;
 context_of_items : representation_context;
END_ENTITY;
ENTITY shape_representation SUBTYPE OF (representation);
END_ENTITY;
ENTITY advanced_brep_shape_representation SUBTYPE OF (shape_representation);
END_ENTITY;
ENTITY faceted_brep_shape_representation SUBTYPE OF (shape_representation);
END_ENTITY;
ENTITY manifold_surface_shape_representation SUBTYPE OF (shape_representation);
END_ENTITY;
ENTITY geometrically_bounded_surface_shape_representation SUBTYPE OF (shape_representation);
END_ENTITY;
ENTITY geometrically_bounded_wireframe_shape_representation SUBTYPE OF (shape_representation);
END_ENTITY;
ENTITY edge_based_wireframe_shape_representation SUBTYPE OF (shape_representation);
END_ENTITY;
ENTITY tessellated_shape_representation SUBTYPE OF (shape_representation);
END_ENTITY;
(* The standard resolves the name clash with representation by derived
   redeclaration; this profile renames the two physical attributes instead. *)
ENTITY characterized_object;
 object_name : STRING;
 object_description : OPTIONAL STRING;
END_ENTITY;
ENTITY characterized_representation SUBTYPE OF (representation, characterized_object);
END_ENTITY;
ENTITY representation_relationship;
 name : STRING;
 description : OPTIONAL STRING;
 rep_1 : representation;
 rep_2 : representation;
END_ENTITY;
ENTITY shape_representation_relationship SUBTYPE OF (representation_relationship);
END_ENTITY;
ENTITY representation_relationship_with_transformation SUBTYPE OF (representation_relationship);
 transformation_operator : transformation;
END_ENTITY;
ENTITY item_defined_transformation;
 name : STRING;
 description : OPTIONAL STRING;
 transform_item_1 : representation_item;
 transform_item_2 : representation_item;
END_ENTITY;
ENTITY context_dependent_shape_representation;
 representation_relation : shape_representation_relationship;
 represented_product_relation : product_definition_shape;
END_ENTITY;
END_SCHEMA;
