#200=DRAUGHTING_PRE_DEFINED_CURVE_FONT('continuous');
#201=COLOUR_RGB('red',1.,0.,0.);
#202=CURVE_STYLE('',#200,POSITIVE_LENGTH_MEASURE(0.35),#201);
