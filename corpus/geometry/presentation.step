#110=TESSELLATED_CURVE_SET('frame',#111,((1,2,3,4,1),(1,3)));
#121=COORDINATES_LIST('',5,((0.,0.,0.),(10.,0.,0.),(10.,5.,0.),(0.,5.,0.),(5.,0.,0.)));
#120=COMPLEX_TRIANGULATED_SURFACE_SET('fill',#121,5,((1.,0.,0.)),(),(),((1,2,3,4,1),(1,5,2)));
