(* Original bounded import profile, not an ISO schema. Matches the physical
   attributes of edge-based B-rep solids with elementary and B-spline geometry;
   excludes general AP rules. Swept surfaces and trimmed curves are included; the
   importer reads a trimmed curve's basis curve and sense only, because edge vertices
   bound every use. The curve and surface supertype chains mirror the
   physical component names of complex B-spline instances. SURFACE_CURVE
   associated geometry is generalized to representation_item: the importer
   retains those links without decoding them and computes its own pcurves. *)
SCHEMA tessstep_brep;
TYPE b_spline_curve_form = ENUMERATION OF
 (polyline_form, circular_arc, elliptic_arc, parabolic_arc, hyperbolic_arc, unspecified);
END_TYPE;
TYPE b_spline_surface_form = ENUMERATION OF
 (plane_surf, cylindrical_surf, conical_surf, spherical_surf, toroidal_surf,
  surf_of_revolution, ruled_surf, generalised_cone, quadric_surf,
  surf_of_linear_extrusion, unspecified);
END_TYPE;
TYPE knot_type = ENUMERATION OF
 (uniform_knots, quasi_uniform_knots, piecewise_bezier_knots, unspecified);
END_TYPE;
TYPE preferred_surface_curve_representation = ENUMERATION OF
 (curve_3d, pcurve_s1, pcurve_s2);
END_TYPE;
TYPE parameter_value = REAL;
END_TYPE;
TYPE trimming_select = SELECT (cartesian_point, parameter_value);
END_TYPE;
TYPE trimming_preference = ENUMERATION OF
 (cartesian, parameter, unspecified);
END_TYPE;
ENTITY representation_item;
 name : STRING;
END_ENTITY;
ENTITY geometric_representation_item SUBTYPE OF (representation_item);
END_ENTITY;
ENTITY cartesian_point SUBTYPE OF (geometric_representation_item);
 coordinates : LIST [3:3] OF REAL;
END_ENTITY;
ENTITY direction SUBTYPE OF (geometric_representation_item);
 direction_ratios : LIST [3:3] OF REAL;
END_ENTITY;
ENTITY vector SUBTYPE OF (geometric_representation_item);
 orientation : direction;
 magnitude : REAL;
END_ENTITY;
ENTITY axis1_placement SUBTYPE OF (geometric_representation_item);
 location : cartesian_point;
 axis : OPTIONAL direction;
END_ENTITY;
ENTITY axis2_placement_3d SUBTYPE OF (geometric_representation_item);
 location : cartesian_point;
 axis : OPTIONAL direction;
 ref_direction : OPTIONAL direction;
END_ENTITY;
ENTITY curve SUBTYPE OF (geometric_representation_item);
END_ENTITY;
ENTITY line SUBTYPE OF (curve);
 pnt : cartesian_point;
 dir : vector;
END_ENTITY;
ENTITY conic SUBTYPE OF (curve);
 position : axis2_placement_3d;
END_ENTITY;
ENTITY circle SUBTYPE OF (conic);
 radius : REAL;
END_ENTITY;
ENTITY ellipse SUBTYPE OF (conic);
 semi_axis_1 : REAL;
 semi_axis_2 : REAL;
END_ENTITY;
ENTITY bounded_curve SUBTYPE OF (curve);
END_ENTITY;
ENTITY b_spline_curve SUBTYPE OF (bounded_curve);
 degree : INTEGER;
 control_points_list : LIST [2:?] OF cartesian_point;
 curve_form : b_spline_curve_form;
 closed_curve : LOGICAL;
 self_intersect : LOGICAL;
END_ENTITY;
ENTITY b_spline_curve_with_knots SUBTYPE OF (b_spline_curve);
 knot_multiplicities : LIST [2:?] OF INTEGER;
 knots : LIST [2:?] OF REAL;
 knot_spec : knot_type;
END_ENTITY;
ENTITY quasi_uniform_curve SUBTYPE OF (b_spline_curve);
END_ENTITY;
ENTITY rational_b_spline_curve SUBTYPE OF (b_spline_curve);
 weights_data : LIST [2:?] OF REAL;
END_ENTITY;
ENTITY trimmed_curve SUBTYPE OF (bounded_curve);
 basis_curve : curve;
 trim_1 : SET [1:2] OF trimming_select;
 trim_2 : SET [1:2] OF trimming_select;
 sense_agreement : BOOLEAN;
 master_representation : trimming_preference;
END_ENTITY;
ENTITY surface_curve SUBTYPE OF (curve);
 curve_3d : curve;
 associated_geometry : LIST [1:2] OF representation_item;
 master_representation : preferred_surface_curve_representation;
END_ENTITY;
ENTITY seam_curve SUBTYPE OF (surface_curve);
END_ENTITY;
ENTITY intersection_curve SUBTYPE OF (surface_curve);
END_ENTITY;
ENTITY surface SUBTYPE OF (geometric_representation_item);
END_ENTITY;
ENTITY elementary_surface SUBTYPE OF (surface);
 position : axis2_placement_3d;
END_ENTITY;
ENTITY plane SUBTYPE OF (elementary_surface);
END_ENTITY;
ENTITY cylindrical_surface SUBTYPE OF (elementary_surface);
 radius : REAL;
END_ENTITY;
ENTITY conical_surface SUBTYPE OF (elementary_surface);
 radius : REAL;
 semi_angle : REAL;
END_ENTITY;
ENTITY spherical_surface SUBTYPE OF (elementary_surface);
 radius : REAL;
END_ENTITY;
ENTITY toroidal_surface SUBTYPE OF (elementary_surface);
 major_radius : REAL;
 minor_radius : REAL;
END_ENTITY;
ENTITY degenerate_toroidal_surface SUBTYPE OF (toroidal_surface);
 select_outer : BOOLEAN;
END_ENTITY;
ENTITY swept_surface SUBTYPE OF (surface);
 swept_curve : curve;
END_ENTITY;
ENTITY surface_of_linear_extrusion SUBTYPE OF (swept_surface);
 extrusion_axis : vector;
END_ENTITY;
ENTITY surface_of_revolution SUBTYPE OF (swept_surface);
 axis_position : axis1_placement;
END_ENTITY;
ENTITY bounded_surface SUBTYPE OF (surface);
END_ENTITY;
ENTITY b_spline_surface SUBTYPE OF (bounded_surface);
 u_degree : INTEGER;
 v_degree : INTEGER;
 control_points_list : LIST [2:?] OF LIST [2:?] OF cartesian_point;
 surface_form : b_spline_surface_form;
 u_closed : LOGICAL;
 v_closed : LOGICAL;
 self_intersect : LOGICAL;
END_ENTITY;
ENTITY b_spline_surface_with_knots SUBTYPE OF (b_spline_surface);
 u_multiplicities : LIST [2:?] OF INTEGER;
 v_multiplicities : LIST [2:?] OF INTEGER;
 u_knots : LIST [2:?] OF REAL;
 v_knots : LIST [2:?] OF REAL;
 knot_spec : knot_type;
END_ENTITY;
ENTITY quasi_uniform_surface SUBTYPE OF (b_spline_surface);
END_ENTITY;
ENTITY rational_b_spline_surface SUBTYPE OF (b_spline_surface);
 weights_data : LIST [2:?] OF LIST [2:?] OF REAL;
END_ENTITY;
ENTITY vertex_point SUBTYPE OF (representation_item);
 vertex_geometry : cartesian_point;
END_ENTITY;
ENTITY edge SUBTYPE OF (representation_item);
 edge_start : vertex_point;
 edge_end : vertex_point;
END_ENTITY;
ENTITY edge_curve SUBTYPE OF (edge);
 edge_geometry : curve;
 same_sense : BOOLEAN;
END_ENTITY;
(* The importer declares EDGE_START/EDGE_END as physical * slots for this subtype.
   Their semantic endpoints are taken from EDGE_ELEMENT using ORIENTATION. *)
ENTITY oriented_edge SUBTYPE OF (edge);
 edge_element : edge_curve;
 orientation : BOOLEAN;
END_ENTITY;
ENTITY loop ABSTRACT SUBTYPE OF (representation_item);
END_ENTITY;
ENTITY edge_loop SUBTYPE OF (loop);
 edge_list : LIST [1:?] OF oriented_edge;
END_ENTITY;
ENTITY vertex_loop SUBTYPE OF (loop);
 loop_vertex : vertex_point;
END_ENTITY;
ENTITY face_bound SUBTYPE OF (representation_item);
 bound : loop;
 orientation : BOOLEAN;
END_ENTITY;
ENTITY face_outer_bound SUBTYPE OF (face_bound);
END_ENTITY;
ENTITY face SUBTYPE OF (representation_item);
 bounds : SET [1:?] OF face_bound;
END_ENTITY;
ENTITY face_surface SUBTYPE OF (face);
 face_geometry : surface;
 same_sense : BOOLEAN;
END_ENTITY;
ENTITY advanced_face SUBTYPE OF (face_surface);
END_ENTITY;
ENTITY closed_shell SUBTYPE OF (representation_item);
 cfs_faces : SET [1:?] OF face_surface;
END_ENTITY;
(* The importer declares CFS_FACES as a physical * slot for this subtype; its faces
   are those of CLOSED_SHELL_ELEMENT, used with ORIENTATION. *)
ENTITY oriented_closed_shell SUBTYPE OF (closed_shell);
 closed_shell_element : closed_shell;
 orientation : BOOLEAN;
END_ENTITY;
ENTITY manifold_solid_brep SUBTYPE OF (representation_item);
 outer : closed_shell;
END_ENTITY;
ENTITY brep_with_voids SUBTYPE OF (manifold_solid_brep);
 voids : SET [1:?] OF oriented_closed_shell;
END_ENTITY;
END_SCHEMA;
