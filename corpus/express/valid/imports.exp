SCHEMA consumer;
USE FROM base (part AS component, choice);
REFERENCE FROM base (factor);
ENTITY assembly;
  children : LIST [0:?] OF UNIQUE component;
  selected : choice;
END_ENTITY;
END_SCHEMA;
SCHEMA downstream;
USE FROM consumer (component);
ENTITY container;
  child : component;
END_ENTITY;
END_SCHEMA;
