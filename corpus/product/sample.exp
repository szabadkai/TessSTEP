(* Original reduced test schema for semantic adapters. Not an ISO/AP schema.
   Deliberately omits administrative attributes and general EXPRESS rules. *)
SCHEMA product_test;
ENTITY product;
 id : STRING;
 name : STRING;
END_ENTITY;
ENTITY product_definition_formation;
 id : STRING;
 of_product : product;
END_ENTITY;
ENTITY product_definition;
 id : STRING;
 formation : product_definition_formation;
END_ENTITY;
ENTITY product_definition_relationship;
 id : STRING;
 relating_product_definition : product_definition;
 related_product_definition : product_definition;
END_ENTITY;
ENTITY next_assembly_usage_occurrence SUBTYPE OF (product_definition_relationship);
END_ENTITY;
TYPE characterized = SELECT (product_definition, product_definition_relationship);
END_TYPE;
ENTITY product_definition_shape;
 definition : characterized;
END_ENTITY;
ENTITY dimensional_exponents;
 length_exponent : REAL;
 mass_exponent : REAL;
 time_exponent : REAL;
 electric_current_exponent : REAL;
 thermodynamic_temperature_exponent : REAL;
 amount_of_substance_exponent : REAL;
 luminous_intensity_exponent : REAL;
END_ENTITY;
ENTITY named_unit;
END_ENTITY;
ENTITY length_unit SUBTYPE OF (named_unit);
END_ENTITY;
ENTITY plane_angle_unit SUBTYPE OF (named_unit);
END_ENTITY;
ENTITY solid_angle_unit SUBTYPE OF (named_unit);
END_ENTITY;
TYPE prefix_name = ENUMERATION OF (exa,peta,tera,giga,mega,kilo,hecto,deca,deci,centi,milli,micro,nano,pico,femto,atto);
END_TYPE;
TYPE unit_name = ENUMERATION OF (metre,radian,steradian,second);
END_TYPE;
ENTITY si_unit SUBTYPE OF (named_unit);
 prefix : OPTIONAL prefix_name;
 name : unit_name;
END_ENTITY;
ENTITY si_length SUBTYPE OF (length_unit, si_unit);
END_ENTITY;
ENTITY si_plane_angle SUBTYPE OF (plane_angle_unit, si_unit);
END_ENTITY;
ENTITY si_solid_angle SUBTYPE OF (solid_angle_unit, si_unit);
END_ENTITY;
ENTITY measure_with_unit;
 value_component : REAL;
 unit_component : named_unit;
END_ENTITY;
ENTITY conversion_based_unit SUBTYPE OF (named_unit);
 dimensions : dimensional_exponents;
 name : STRING;
 conversion_factor : measure_with_unit;
END_ENTITY;
ENTITY converted_length SUBTYPE OF (length_unit, conversion_based_unit);
END_ENTITY;
ENTITY converted_angle SUBTYPE OF (plane_angle_unit, conversion_based_unit);
END_ENTITY;
ENTITY conversion_based_unit_with_offset SUBTYPE OF (conversion_based_unit);
 offset : REAL;
END_ENTITY;
ENTITY offset_length SUBTYPE OF (length_unit,conversion_based_unit_with_offset);
END_ENTITY;
ENTITY representation_context;
END_ENTITY;
ENTITY geometric_representation_context SUBTYPE OF (representation_context);
 coordinate_space_dimension : INTEGER;
END_ENTITY;
ENTITY global_unit_assigned_context SUBTYPE OF (representation_context);
 units : SET [1:?] OF named_unit;
END_ENTITY;
ENTITY model_context SUBTYPE OF (geometric_representation_context, global_unit_assigned_context);
END_ENTITY;
ENTITY representation_item;
 name : STRING;
END_ENTITY;
ENTITY representation;
 name : STRING;
 items : SET [1:?] OF representation_item;
 context_of_items : representation_context;
END_ENTITY;
ENTITY shape_definition_representation;
 definition : product_definition_shape;
 used_representation : representation;
END_ENTITY;
ENTITY item_defined_transformation;
 transform_item_1 : representation_item;
 transform_item_2 : representation_item;
END_ENTITY;
ENTITY representation_relationship;
 rep_1 : representation;
 rep_2 : representation;
END_ENTITY;
ENTITY representation_relationship_with_transformation SUBTYPE OF (representation_relationship);
 transformation_operator : transformation;
END_ENTITY;
ENTITY context_dependent_shape_representation;
 representation_relation : representation_relationship;
 represented_product_relation : product_definition_shape;
END_ENTITY;
ENTITY representation_map;
 mapping_origin : representation_item;
 mapped_representation : representation;
END_ENTITY;
ENTITY mapped_item SUBTYPE OF (representation_item);
 mapping_source : representation_map;
 mapping_target : representation_item;
END_ENTITY;
ENTITY opaque_geometry SUBTYPE OF (representation_item);
END_ENTITY;

ENTITY cartesian_point SUBTYPE OF (representation_item);
 coordinates : LIST [1:3] OF REAL;
END_ENTITY;
ENTITY direction SUBTYPE OF (representation_item);
 direction_ratios : LIST [1:3] OF REAL;
END_ENTITY;
ENTITY axis2_placement_3d SUBTYPE OF (representation_item);
 location : cartesian_point;
 axis : OPTIONAL direction;
 ref_direction : OPTIONAL direction;
END_ENTITY;
ENTITY cartesian_transformation_operator_3d SUBTYPE OF (representation_item);
 axis1 : OPTIONAL direction;
 axis2 : OPTIONAL direction;
 local_origin : cartesian_point;
 scale : OPTIONAL REAL;
 axis3 : OPTIONAL direction;
END_ENTITY;
(* Supplemental nonuniform operator for caller-supplied schema testing. *)
ENTITY cartesian_transformation_operator_3d_non_uniform SUBTYPE OF (cartesian_transformation_operator_3d);
 scale2 : OPTIONAL REAL;
 scale3 : OPTIONAL REAL;
END_ENTITY;
TYPE transformation = SELECT (item_defined_transformation,cartesian_transformation_operator_3d);
END_TYPE;
ENTITY shape_representation_relationship SUBTYPE OF (representation_relationship);
END_ENTITY;
ENTITY uncertainty_measure_with_unit SUBTYPE OF (measure_with_unit);
 name : STRING;
 description : OPTIONAL STRING;
END_ENTITY;
ENTITY global_uncertainty_assigned_context SUBTYPE OF (representation_context);
 uncertainty : SET [1:?] OF uncertainty_measure_with_unit;
END_ENTITY;
ENTITY uncertain_context SUBTYPE OF (model_context,global_uncertainty_assigned_context);
END_ENTITY;
ENTITY item_group SUBTYPE OF (representation_item);
 children : SET [1:?] OF representation_item;
END_ENTITY;
END_SCHEMA;
